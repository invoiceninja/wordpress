{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "invoiceninja/add-to-cart",
	"title": "Add to Cart Button",
	"category": "invoiceninja",
	"description": "A button that adds one product to the cart (or buys it straight away in Buy Now mode).",
	"icon": "cart",
	"keywords": [
		"buy",
		"button"
	],
	"textdomain": "invoiceninja",
	"attributes": {
		"productId": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"quantity": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		},
		"color": {
			"text": true,
			"background": true
		}
	}
}
