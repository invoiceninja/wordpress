# Invoice Ninja dev settings (based on invoiceninja/dockerfiles debian/.env).
# Local-only: the stack is reachable only through the proxy on this machine's loopback.
# The key and passwords below are for this throwaway dev instance only.
APP_URL=http://in.localhost:8089
APP_KEY=base64:dFAesr84f8xWjp5BxIJqiWwwUNv1CB/pidbCB7ExGZg=
APP_ENV=production
APP_DEBUG=true
REQUIRE_HTTPS=false
TRUSTED_PROXIES='*'
IS_DOCKER=true
PDF_GENERATOR=snappdf
PHANTOMJS_PDF_GENERATION=false
FILESYSTEM_DISK=debian_docker
SCOUT_DRIVER=null

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=in-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

DB_CONNECTION=mysql
DB_HOST=in-db
DB_PORT=3306
DB_DATABASE=ninja
DB_USERNAME=ninja
DB_PASSWORD=ninja

# First-run account
IN_USER_EMAIL=admin@example.com
IN_PASSWORD=Dev-Only-Pass-123!

# Mail is written to the log (storage/logs), nothing is sent
MAIL_MAILER=log
MAIL_FROM_ADDRESS='billing@example.com'
MAIL_FROM_NAME='Invoice Ninja Dev'
