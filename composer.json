{
    "name": "invoiceninja/wordpress",
    "description": "Invoice Ninja for WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Invoice Ninja",
            "email": "contact@invoiceninja.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "woocommerce/action-scheduler": "^3.9"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/wordpress-stubs": "^6.7",
        "php-stubs/wp-cli-stubs": "^2.11",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "InvoiceNinja\\": [
                "src/",
                "InvoiceNinja/"
            ],
            "Templates\\": "templates/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InvoiceNinja\\Tests\\": "./tests/unit"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "phpcs"
    }
}
