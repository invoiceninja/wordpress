{
    "name": "invoiceninja/wordpress",
    "description": "WordPress plugin for Invoice Ninja",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Invoice Ninja",
            "email": "contact@invoiceninja.com"
        }
    ],
    "require": {},
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "InvoiceNinja\\": "./InvoiceNinja",
            "Templates\\": "./templates"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InvoiceNinja\\Tests\\": "./tests/unit"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --testsuite unit"
    }
}
