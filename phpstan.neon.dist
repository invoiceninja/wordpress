includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
	level: 6
	paths:
		- src
	scanFiles:
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
		- tests/phpstan/stubs.php
	bootstrapFiles:
		- tests/phpstan/bootstrap.php
	treatPhpDocTypesAsCertain: false
	dynamicConstantNames:
		- COOKIEPATH
		- COOKIE_DOMAIN
